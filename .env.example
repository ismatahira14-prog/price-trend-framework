# Copy to .env and edit as needed. Loaded automatically by pricelab.config.

# Where the data/ tree lives. Leave unset to use <repo>/data.
# On Google Colab, after mounting Drive, set this to your Drive folder, e.g.:
# PRICELAB_DATA_DIR=/content/drive/MyDrive/price-trend-framework/data
# PRICELAB_DATA_DIR=

# SQL Server connection. Copy this file to `.env` and fill these values.
# `.env` is git-ignored; never commit credentials.
PRICELAB_SQL_SERVER=192.0.2.10
PRICELAB_SQL_PORT=1433
# `master` is sufficient for the connection check. Later table reads can use
# fully qualified [Database].[Schema].[Table] names.
PRICELAB_SQL_DATABASE=master
PRICELAB_SQL_USERNAME=YourUsername
PRICELAB_SQL_PASSWORD=YourPassword

# Set true only when using Windows Authentication; username/password are then ignored.
PRICELAB_SQL_TRUSTED_CONNECTION=false

# Keep encryption enabled. Set certificate trust true only for a server whose
# certificate cannot yet be validated (commonly a local/dev SQL Server).
PRICELAB_SQL_ENCRYPT=true
PRICELAB_SQL_TRUST_SERVER_CERTIFICATE=false
